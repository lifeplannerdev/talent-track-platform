# Copy to .env.local. Never commit real values.
# Local Supabase (npm run db:start prints the real values; run `npx supabase status` any time).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key from supabase status>
# Server only. Used by staff actions that create users and by the attempt code (start, save, submit and scoring).
SUPABASE_SERVICE_ROLE_KEY=<secret/service_role key from supabase status>

# Server only. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sweep.
CRON_SECRET=<long random string>

# Mail (server only). MAIL_TRANSPORT is "log" (default outside production; sends nothing, logs only the recipient domain) or "resend".
# In production set MAIL_TRANSPORT=resend. Resend needs RESEND_API_KEY and MAIL_FROM (a sender on a domain verified in Resend).
MAIL_TRANSPORT=log
RESEND_API_KEY=<Resend API key, only when MAIL_TRANSPORT=resend>
MAIL_FROM=Talent Track Platform <no-reply@your-verified-domain>
# Public base URL of this app, used to build the one-time links in invite emails (no trailing slash).
APP_URL=http://localhost:3000
